---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const reports = (await getCollection('reports', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="이동현 — Agent Runtime / Harness Engineering">
  <main>
    <h1>이동현</h1>
    <p class="lede">Agent Runtime과 Harness를 만듭니다.</p>

    <section aria-label="리포트 목록">
      <ul class="report-list">
        {
          reports.map((report) => (
            <li>
              <a href={`/reports/${report.id}`}>
                <span class="report-title">{report.data.title}</span>
                <span class="report-summary">{report.data.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 68ch;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }
  h1 {
    margin: 0 0 0.25rem;
  }
  .lede {
    color: var(--fg-muted);
    margin: 0 0 2.5rem;
  }
  .report-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .report-list a {
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--fg);
  }
  .report-list a:hover {
    border-color: var(--link);
  }
  .report-title {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .report-summary {
    display: block;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
</style>
