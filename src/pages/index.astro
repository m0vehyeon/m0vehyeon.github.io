import BaseLayout from '../layouts/BaseLayout.astro';

function splitRole(role: string) {
  const m = role.match(/^(주도|담당|참여)(.*)$/);
  if (!m) return null;
  return { word: m[1], cls: m[1] === '주도' ? 'lead' : m[1] === '담당' ? 'own' : 'part', rest: m[2].trim() };
}

